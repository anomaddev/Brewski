[Unit]
Description=Ask before updating Brewski
After=local-fs.target
Before=brewski.service

[Service]
Type=oneshot
Environment=BREWSKI_DATA_DIR=/var/lib/brewski
WorkingDirectory=/var/lib/brewski
ExecStart=/opt/brewski/venv/bin/brewski boot-update
TimeoutStartSec=900
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
