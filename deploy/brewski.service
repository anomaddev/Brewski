[Unit]
Description=Brewski still controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this if the Pi account is not named pi.
User=pi
Group=pi
Environment=BREWSKI_DATA_DIR=/var/lib/brewski
Environment=BREWSKI_HOST=0.0.0.0
Environment=BREWSKI_PORT=8080
ExecStart=/opt/brewski/venv/bin/brewski
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
