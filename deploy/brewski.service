[Unit]
Description=Brewski still controller
After=brewski-update.service
Wants=brewski-update.service

[Service]
Type=simple
# Change this if the Pi account is not named pi.
User=pi
Group=pi
Environment=BREWSKI_DATA_DIR=/var/lib/brewski
Environment=BREWSKI_HOST=0.0.0.0
Environment=BREWSKI_PORT=8080
# lgpio creates a notify pipe in the working directory at import time.
WorkingDirectory=/var/lib/brewski
ExecStart=/opt/brewski/venv/bin/brewski
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
